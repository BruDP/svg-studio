datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model FeedMeta {
  id           Int      @id @default(autoincrement())
  sourceHash   String
  downloadedAt DateTime @default(now())
}

model Product {
  sku        String   @id
  payload    String   // JSON di ProductRecord
  rowHash    String
  searchText String   // lowercase: sku + descrizione breve, per LIKE
  updatedAt  DateTime @updatedAt
}

model Extraction {
  sku       String
  inputHash String
  proposal  String   // JSON di SchedaProposal
  createdAt DateTime @default(now())

  @@id([sku, inputHash])
}

model Icon {
  key       String   @id // chiave canonica del dizionario
  svg       String
  source    String   // 'locale' | 'iconify:<set>' | 'gemini'
  license   String
  status    String   // 'approvata' | 'in-revisione'
  updatedAt DateTime @updatedAt
}

model Scene {
  sku       String   @id
  sceneJson String
  updatedAt DateTime @updatedAt
}

model VisionBBox {
  imageHash String   @id
  trovato   Boolean
  left      Int?
  top       Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

// Cache Vision per la prospettiva (direzione/angolo/verso dello spigolo di profondità).
// Il caso "frontale/nessuna prospettiva" è rappresentato da una riga con direzione='nessuna'
// (angoloDeg=0, verso='nessuno') anziché dall'assenza di riga: così si distingue "mai chiesto"
// (nessuna riga → undefined in loadProspettiva) da "chiesto, risultato: frontale" (riga con
// direzione='nessuna' → null), evitando di richiamare Vision ad ogni volta sulle foto frontali.
model VisionProspettiva {
  hash      String   @id
  direzione String
  angoloDeg Float
  verso     String
  // "vision" (default, scritta da resolveProspettiva) oppure "manuale" (correzione dell'operatore
  // in editor, catturata da saveSceneAction): una riga 'manuale' non viene più sovrascritta da
  // Vision, così la correzione persiste su tutte le generazioni/batch successivi.
  origine   String   @default("vision")
  createdAt DateTime @default(now())
}

// Tracker costi Gemini: per ogni estrazione/Vision, registra input token, output token, costo USD.
// Tracciamento da 2026-07-24 in poi. Esportabile CSV per amministrazione.
model CostLog {
  id            Int      @id @default(autoincrement())
  sku           String
  operazione    String   // 'extraction' | 'vision'
  modello       String   // es. 'gemini-2.5-pro', 'gemini-vision'
  inputTokens   Int
  outputTokens  Int
  costUsd       Float    // calcolato da Gemini response
  createdAt     DateTime @default(now())

  @@index([sku])
  @@index([createdAt])
}

